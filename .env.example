# Copy this file to `.env` and fill in real values for your environment.
# `.env` is gitignored — never commit real secrets.
# See docs/configuration.md for how this fits together with .flaskenv and
# app/config.py.

# Used to sign sessions and CSRF tokens (Flask-WTF). Falls back to "dev" in
# app/config.py if unset — fine for local development, but must be set to a
# real, random value before anything resembling a shared/production
# deployment.
SECRET_KEY=

# Overrides the default SQLite file (instance/app.db) — set this to point
# at a real database (e.g. Postgres) in production. Leave empty for local
# development.
DATABASE_URL=

# Google sign-in (OAuth 2.0 / OpenID Connect). Create a "Web application"
# OAuth client in Google Cloud Console and add
#   http://127.0.0.1:5000/auth/google/callback
# as an Authorized redirect URI. See docs/authentication.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
